{
  // driftfever.com. Since 15 November 2026 the assets directory is site/,
  // which build-site.js assembles before every deploy: the 3D game from
  // crazygames/ at the root, the original one file game at /classic/, the
  // seven pages and what they need. build-site.js is the allowlist: nothing
  // reaches the web unless it copies it. See CLAUDE.md.
  "name": "drift-fever",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node build-site.js" },
  "assets": { "directory": "./site" }
}
