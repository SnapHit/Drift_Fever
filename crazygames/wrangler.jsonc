{
  // Drift Fever: CrazyGames edition. A static assets Worker: dist/ is the
  // web root and it is built by `npm run build`, which refuses to build
  // while the parity stamp is stale. See CLAUDE.md for the deploy.
  "name": "drift-fever-crazygames",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
